.data/

# Environment / secrets
.env
.env.*
*.env
secrets/
**/secrets/
*.dpapi
*.key
*.p12
*.pem
credentials*
*credential*

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Operator finance portfolio (PII) — debts/liabilities/payment schedules etc.
