# ============================================================================
# Samus Compose env template.
#
# Copy to `.env` (same directory) and fill in real values:
#   cp .env.example .env
#
# NEVER commit a populated copy. The `.env` filename is covered by repo
# gitignore + docker/.dockerignore, but `.env.example` is the only file in
# this folder that is safe to track.
# ============================================================================

# --- Cross-service auth (HMAC) ----------------------------------------------
# 32+ random bytes, base64 or hex. The gateway and every workcell must agree.
SAMUS_SHARED_HMAC_KEY=

# --- External API keys ------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# OpenAI API key for LLM inference (Cloud Run backend). When set, Samus uses
# the OpenAI Chat Completions API instead of LM Studio. Required on Cloud Run.
OPENAI_API_KEY=

# Stripe restricted-read key for the finance workcell. Optional — without it
# /codb_summary and /runway still work; only /snapshot needs Stripe live.
STRIPE_API_KEY=

# Stripe webhook signing secret (whsec_...). Required for POST /finance/stripe_webhook
# to verify inbound checkout.session.completed events. Without it, the endpoint
# returns HTTP 400 'webhook_secret_unset'. Get from Dashboard > Developers > Webhooks
# after adding the finance workcell as a webhook target.
STRIPE_WEBHOOK_SECRET=

# Comma-separated whitelist of hf_offer_code values that trigger post-payment
# auto-fulfill (Win #2). Example: SAMUS_AUTO_FULFILL_OFFERS=seo_audit
# Empty -> operator runs Run-Fulfill.ps1 manually for every sale.
# Requires the matching Stripe payment_link to expose a `website_url` checkout
# custom_field (Dashboard > Payment links > <link> > Customize > Custom fields).
# Without the URL field, the handler still skips even whitelisted offers.
SAMUS_AUTO_FULFILL_OFFERS=

# Vapi private API key for the voice workcell. Optional — without it,
# /voice/call returns vapi_error=vapi_api_key_unset. /vapi/webhook works
# independently (it doesn't need this key to receive events).
VAPI_API_KEY=

# Vapi webhook HMAC-SHA256 shared secret. Required for /vapi/webhook in
# production. Returns 503 if unset, unless SAMUS_VOICE_VERIFY_WEBHOOK=0
# (intended for the test suite only).
VAPI_WEBHOOK_SECRET=

# --- Email backend (selector + per-provider config) -------------------------
# The selector in backend/common/email_backend.py routes send_email() calls
# to one of: "sendgrid" (built, default) | "ses" (not yet lifted into common/;
# use backend/outreach/ses_adapter.py directly for now).
EMAIL_BACKEND=sendgrid

# SendGrid Mail Send v3 API key (SG.xxx). Required when EMAIL_BACKEND=sendgrid.
# Get from SendGrid Dashboard > Settings > API Keys with at least "Mail Send"
# scope. Without it, send_email() raises EmailBackendError.
SENDGRID_API_KEY=

# Verified sender address. Must match a Single-Sender-verified address or a
# domain-authenticated domain in SendGrid (Settings > Sender Authentication).
# Required when EMAIL_BACKEND=sendgrid.
SENDGRID_FROM_EMAIL=

# Display name shown next to the from address. Defaults to "HustleForge".
SENDGRID_FROM_NAME=HustleForge

# Reply-To header. Empty -> mail clients fall back to From for replies.
# Set when From is unmonitored / when you want replies routed somewhere
# distinct (e.g. a billing-monitor inbox).
SENDGRID_REPLY_TO=

# Override only if your account is provisioned on an EU subuser:
#   https://api.eu.sendgrid.com
# Default is the global region.
SENDGRID_BASE_URL=https://api.sendgrid.com

# --- AWS credentials for SQS / S3 ------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1

# --- SQS queue URLs (one per workcell with a queue) -------------------------
SQS_LEADGEN_QUEUE_URL=
SQS_PROSPECTING_QUEUE_URL=
SQS_SCAFFOLD_QUEUE_URL=
SQS_FULFILLMENT_QUEUE_URL=

# --- SQS queue URLs (remaining workcells) -----------------------------------
SQS_FEEDBACK_QUEUE_URL=
SQS_OUTREACH_QUEUE_URL=
SQS_OPTIMIZER_QUEUE_URL=
SQS_PROPOSAL_QUEUE_URL=
SQS_SEO_QUEUE_URL=
SQS_CRM_QUEUE_URL=

# --- Neo4j (Hivemind store) -------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Cloud Run standalone AuraDB (bolt URI). Local Compose uses host.docker.internal.
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io

# --- LLM budget scaler (OpenAI CODB controls) ------------------------------
# Fraction of MRR reinvested into daily LLM budget. Default 5%.
SAMUS_LLM_REINVEST_PCT=0.05
# Absolute floor and ceiling for the daily LLM spend ($USD).
SAMUS_LLM_DAILY_FLOOR_USD=0.50
SAMUS_LLM_DAILY_CEILING_USD=25.00
# Force dynamic cap on/off regardless of backend. Auto-enabled on OpenAI.
# SAMUS_LLM_DYNAMIC_CAP=true
