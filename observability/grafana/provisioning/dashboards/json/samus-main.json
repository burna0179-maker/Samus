{
  "uid": "samus-main",
  "title": "Samus â shell",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Gateway up",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "up{job=\"samus-gateway\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Health (gateway)",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "samus_health_state{component=\"gateway\"}", "refId": "A" }]
    },
    {
      "type": "graph",
      "title": "Dispatches / sec",
      "id": 3,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [{ "expr": "rate(queue_dispatch_total[1m])", "refId": "A", "legendFormat": "{{service}}/{{action}}" }]
    },
    {
      "type": "graph",
      "title": "Dispatch p95 latency (s)",
      "id": 4,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(queue_dispatch_duration_seconds_bucket[5m]))", "refId": "A" }]
    },
    {
      "type": "graph",
      "title": "Dispatch errors / sec",
      "id": 5,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(queue_dispatch_errors_total[5m])", "refId": "A", "legendFormat": "{{service}}/{{reason}}" }]
    },
    {
      "type": "graph",
      "title": "CODB USD (5m rate)",
      "id": 6,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [{ "expr": "rate(smms_codb_usd_total[5m])", "refId": "A", "legendFormat": "{{service}}/{{backend}}/{{operation}}" }]
    }
  ]
}
